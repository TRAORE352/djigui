# =====================================================================
#  DJIGUI — backend, variables d'environnement.
#  Copiez ce fichier en .env et remplissez les valeurs réelles.
#  .env n'est jamais suivi par Git (voir .gitignore).
# =====================================================================

# Chaîne Session pooler de Supabase (réseau IPv4, connexion persistante).
# À copier depuis le tableau de bord Supabase, bouton « Connect ».
DATABASE_URL=postgresql://postgres.[REF_PROJET]:[MOT_DE_PASSE]@aws-0-[région].pooler.supabase.com:5432/postgres

# Longue suite de caractères au hasard, sans espace. Sert à signer les
# jetons de session (JWT) : sans lui, le service refuse de démarrer.
JWT_SECRET=

# Port d'écoute du backend. 4000 par défaut si absent.
PORT=4000

# Origines autorisées à appeler l'API, séparées par des virgules. Le
# frontend tourne sur 3000 ; 3001 est aussi autorisé au cas où un ancien
# serveur occupe déjà le 3000.
ORIGINES_AUTORISEES=http://localhost:3000,http://localhost:3001

# Clés VAPID (Web Push), à générer UNE SEULE FOIS avec :
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La publique est sans danger à exposer (servie par GET /api/config) ;
# la privée reste strictement dans ce fichier .env, jamais dans Git.
# Sans ces deux valeurs, les notifications push restent désactivées —
# le reste du service fonctionne normalement (canal en plus, pas requis).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:contact@djigui.app
