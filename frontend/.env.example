# =====================================================================
#  DJIGUI — frontend, variables d'environnement.
#  Copiez ce fichier en .env.local et remplissez la valeur réelle.
#  .env.local n'est jamais suivi par Git (voir .gitignore) ; Next.js ne
#  relit ce fichier qu'au démarrage : après une modification, relancez
#  npm run dev.
# =====================================================================

# Adresse de la couche de service (backend). En développement local,
# laissez vide : le repli sur http://localhost:4000 (frontend/lib/api.js)
# suffit. En production (Vercel), mettez l'URL du service Render, sans
# barre oblique finale.
NEXT_PUBLIC_API_URL=
